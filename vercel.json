{
  "framework": "nextjs",
  "regions": ["gru1"],
  "functions": {
    "src/app/api/**/*.ts": { "maxDuration": 300 }
  },
  "crons": [{ "path": "/api/cron", "schedule": "0 11 * * *" }],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
  ]
}
